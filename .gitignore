# Entorno virtual
.venv/
venv/

# Variables de entorno y secretos
.env

# Archivos generados por la aplicación
storage/database/*
storage/exports/*
storage/covers/*
storage/cache/*

# Excepciones para conservar la estructura de carpetas
!storage/database/.gitkeep
!storage/exports/.gitkeep
!storage/covers/.gitkeep
!storage/cache/.gitkeep

